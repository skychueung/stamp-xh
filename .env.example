# Copy to .env and replace every CHANGE_ME value.
STAMP_ENVIRONMENT=production
STAMP_SECRET_KEY=CHANGE_ME_WITH_32_PLUS_RANDOM_CHARACTERS
STAMP_DATABASE_URL=postgresql+psycopg://stamp:CHANGE_ME@db:5432/stamp
STAMP_CORS_ORIGINS=["https://stamp.example.org"]
STAMP_CORS_ALLOW_CREDENTIALS=true
STAMP_PIPELINE_ARTIFACT_ROOT=./data/pipeline_runs
STAMP_MODEL_HOME=./model-runtime
STAMP_PEPMLM_ROOT=models/pepmlm
STAMP_PEPMLM_PYTHON=tools/envs/pepmlm/bin/python
STAMP_PEPMLM_CHECKPOINT=models/pepmlm/ChatterjeeLab_PepMLM-650M/model.safetensors
STAMP_PIPELINE_WORKER_POLL_SECONDS=2
STAMP_PIPELINE_WORKER_LEASE_SECONDS=120
STAMP_PIPELINE_MAX_RETRIES=3
