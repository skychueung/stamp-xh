+"""PepHAR P33L real inference runner.
+
+This runner performs target-driven peptide design using the official PepHAR
+inference classes (evaluate.sample.AnchorBasedSampler, models.get_model).
+It:
+
+1. Accepts either a preprocessed input pickle (--input-pkl) or a receptor PDB
+   (--receptor-pdb). The preprocessed pickle is the canonical input format for
+   PepHAR because the model expects a data dict with rec_aa, rec_coord,
+   pep_aa, pep_coord, etc.
+2. Loads the density and prediction models from the provided checkpoints.
+3. Calls AnchorBasedSampler.sample() to generate peptide coordinates and
+   amino-acid sequences.
+4. Writes generated structures and a manifest.
+
+All outputs are marked NOT_EXPERIMENTALLY_VALIDATED.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import pickle
+import sys
+import time
+from pathlib import Path
+
+BASE_SRC = Path("/mnt/sdb/kxc/stamp_models/source/pephar/extracted_p25_install_probe/PepHAR-main")
+DEFAULT_DENSITY_CHECKPOINT = (
+    "/mnt/sdb/kxc/stamp_models/checkpoints/pephar/p25_install_probe/"
+    "PepHAR_ICLR2025_SHARE/ckpts/density_v4_x5o2_2024_09_08__11_25_36/checkpoints/1400.pt"
+)
+DEFAULT_DENSITY_CONFIG = (
+    "/mnt/sdb/kxc/stamp_models/checkpoints/pephar/p25_install_probe/"
+    "PepHAR_ICLR2025_SHARE/ckpts/density_v4_x5o2_2024_09_08__11_25_36/density_v4_x5o2.yml"
+)
+DEFAULT_PREDICTION_CHECKPOINT = (
+    "/mnt/sdb/kxc/stamp_models/checkpoints/pephar/p25_install_probe/"
+    "PepHAR_ICLR2025_SHARE/ckpts/prediction_d2_x2o1_2024_09_08__11_21_33/checkpoints/2400.pt"
+)
+DEFAULT_PREDICTION_CONFIG = (
+    "/mnt/sdb/kxc/stamp_models/checkpoints/pephar/p25_install_probe/"
+    "PepHAR_ICLR2025_SHARE/ckpts/prediction_d2_x2o1_2024_09_08__11_21_33/prediction_d2_x2o1.yml"
+)
+DEFAULT_PYTHON = Path("/mnt/sdb/kxc/stamp_models/envs/pephar_py310/bin/python")
+
+
+def sha256_file(path: str | Path) -> str:
+    import hashlib
+
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="PepHAR P33L real inference runner")
+    group = parser.add_mutually_exclusive_group(required=True)
+    group.add_argument("--receptor-pdb", help="Path to receptor PDB (will be preprocessed)")
+    group.add_argument("--input-pkl", help="Path to preprocessed PepHAR input pickle")
+    parser.add_argument("--model-variant", choices=["density", "prediction"], default="prediction")
+    parser.add_argument("--density-checkpoint", default=DEFAULT_DENSITY_CHECKPOINT)
+    parser.add_argument("--density-config", default=DEFAULT_DENSITY_CONFIG)
+    parser.add_argument("--prediction-checkpoint", default=DEFAULT_PREDICTION_CHECKPOINT)
+    parser.add_argument("--prediction-config", default=DEFAULT_PREDICTION_CONFIG)
+    parser.add_argument("--output-dir", required=True)
+    parser.add_argument("--gate-file", required=True)
+    parser.add_argument("--seed", type=int, default=2024)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--n-samples", type=int, default=1)
+    parser.add_argument("--anchor-steps", type=int, default=100)
+    parser.add_argument("--finetune-steps", type=int, default=100)
+    args = parser.parse_args(argv)
+    return args
+
+
+def _check_gate(gate_file: Path) -> None:
+    if not gate_file.is_file():
+        raise RuntimeError(f"Gate file missing: {gate_file}")
+    content = gate_file.read_text(encoding="utf-8").strip().lower()
+    if content not in {"1", "true", "yes", "on"}:
+        raise RuntimeError(f"Gate is closed: {gate_file} = {content!r}")
+
+
+def _pdb_to_data_dict(receptor_pdb: Path) -> dict:
+    """Best-effort conversion of a receptor PDB to PepHAR model input format.
+
+    Uses official PepHAR utilities:
+      - utils.protein.parsers.parse_pdb
+      - datasets.transforms.truncate_protein_transform.TruncateProteinV3
+      - datasets.transforms.to_prediction_transform.ToAAPredicitonTaskV4
+    """
+    sys.path.insert(0, str(BASE_SRC))
+    import torch
+    from torchvision import transforms
+    from datasets.transforms.truncate_protein_transform import TruncateProteinV3
+    from datasets.transforms.to_prediction_transform import ToAAPredicitonTaskV4
+    from utils.protein.parsers import parse_pdb
+
+    parsed = parse_pdb(str(receptor_pdb))
+    # parsed has keys: aa, pos_heavyatom, mask_heavyatom, chain_nb, res_nb, ...
+    # Treat everything as receptor; peptide is empty.
+    data = {
+        "name": receptor_pdb.stem,
+        "aa": parsed["aa"],
+        "pos_heavyatom": parsed["pos_heavyatom"],
+        "mask_heavyatom": parsed["mask_heavyatom"],
+        "chain_nb": parsed["chain_nb"],
+        "res_nb": parsed["res_nb"],
+        "resseq": parsed["resseq"],
+        "icode": parsed.get("icode"),
+        "is_peptide": torch.zeros_like(parsed["aa"], dtype=torch.bool),
+    }
+    transform = transforms.Compose([TruncateProteinV3()])
+    data = transform(data)
+    data = ToAAPredicitonTaskV4()(data)
+    return data
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parse_args(argv)
+    start_time = time.time()
+    output_dir = Path(args.output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    manifest = {
+        "model_id": "pephar",
+        "model_variant": args.model_variant,
+        "runner": "stamp_pephar_p33l_real_runner.py",
+        "validation_status": "NOT_EXPERIMENTALLY_VALIDATED",
+        "computational_prediction_only": True,
+        "experimental_validation": False,
+        "receptor_pdb": str(Path(args.receptor_pdb).resolve()) if args.receptor_pdb else None,
+        "input_pkl": str(Path(args.input_pkl).resolve()) if args.input_pkl else None,
+        "density_checkpoint": str(Path(args.density_checkpoint).resolve()),
+        "density_checkpoint_sha256": sha256_file(args.density_checkpoint),
+        "prediction_checkpoint": str(Path(args.prediction_checkpoint).resolve()),
+        "prediction_checkpoint_sha256": sha256_file(args.prediction_checkpoint),
+        "density_config": str(Path(args.density_config).resolve()),
+        "prediction_config": str(Path(args.prediction_config).resolve()),
+        "gate_file": str(Path(args.gate_file).resolve()),
+        "output_dir": str(output_dir.resolve()),
+        "source_entry": str((BASE_SRC / "evaluate" / "sample.py").resolve()),
+        "source_entry_sha256": sha256_file(BASE_SRC / "evaluate" / "sample.py"),
+        "command": " ".join(sys.argv),
+        "status": "BLOCKED",
+        "exit_code": 1,
+        "messages": [],
+    }
+
+    try:
+        _check_gate(Path(args.gate_file))
+        sys.path.insert(0, str(BASE_SRC))
+        import torch
+        from torchvision import transforms
+        from evaluate.sample import AnchorBasedSampler
+        from evaluate.writer import save_pdb_rec_pep
+
+        torch.manual_seed(args.seed)
+        device = torch.device(args.device if torch.cuda.is_available() else "cpu")
+
+        # Load or preprocess input.
+        if args.input_pkl:
+            from datasets.protein_peptide_dataset import ProteinPeptideDataset
+
+            dataset = ProteinPeptideDataset(args.input_pkl, train=False, transform=transforms.Compose([TruncateProteinV3()]), return_name=False)
+            data = dataset[0]
+            manifest["input_format"] = "preprocessed_pickle"
+        else:
+            data = _pdb_to_data_dict(Path(args.receptor_pdb))
+            manifest["input_format"] = "pdb_preprocessed"
+
+        # Build args object for AnchorBasedSampler.
+        class _Args:
+            density_config_path = args.density_config
+            density_param_path = args.density_checkpoint
+            prediction_config_path = args.prediction_config
+            prediction_param_path = args.prediction_checkpoint
+            device = device
+            anchor_steps = args.anchor_steps
+            finetune_steps = args.finetune_steps
+            dist_strategy = "single"
+            anchor_strategy = "gt"
+            extend_strategy = "sto"
+            anchor_nums = 1
+            n_samples = args.n_samples
+
+        sampler = AnchorBasedSampler(_Args())
+
+        generated = []
+        for i in range(args.n_samples):
+            peptide, metrics = sampler.sample(
+                data,
+                anchor_steps=args.anchor_steps,
+                finetune_steps=args.finetune_steps,
+                dist_strategy="single",
+                anchor_strategy="gt",
+                extend_strategy="sto",
+                verbose=False,
+                anchor_nums=1,
+            )
+            out_pdb = output_dir / f"sample_{i}.pdb"
+            save_pdb_rec_pep(data, peptide, str(out_pdb))
+            generated.append({"pdb": str(out_pdb), "metrics": metrics})
+
+        manifest["status"] = "SUCCESS"
+        manifest["exit_code"] = 0
+        manifest["generated"] = generated
+        manifest["messages"].append("Invoked official PepHAR AnchorBasedSampler inference.")
+
+    except Exception as exc:
+        manifest["status"] = "FAILED"
+        manifest["error"] = f"{exc.__class__.__name__}: {exc}"
+        manifest["messages"].append(str(manifest["error"]))
+
+    manifest["elapsed_seconds"] = round(time.time() - start_time, 4)
+    manifest_path = output_dir / "manifest.json"
+    with open(manifest_path, "w", encoding="utf-8") as fh:
+        json.dump(manifest, fh, indent=2, ensure_ascii=False)
+    print(json.dumps(manifest, indent=2, ensure_ascii=False))
+    return manifest["exit_code"]
+
+
+if __name__ == "__main__":
+    sys.exit(main())
