+"""DiffPepBuilder P33L real inference runner.
+
+This runner performs target-driven de novo peptide generation using the official
+DiffPepBuilder inference entry point (experiments/run_inference.py). It:
+
+1. Accepts a target receptor PDB.
+2. Preprocesses the receptor with the official process_receptor.py.
+3. Builds a CSV metadata file pointing to the processed receptor.
+4. Invokes experiments/run_inference.py with a Hydra config that uses the
+   provided checkpoint and the generated CSV.
+
+All outputs are marked NOT_EXPERIMENTALLY_VALIDATED.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+BASE_SRC = Path("/mnt/sdb/kxc/stamp_models/source/diffpepbuilder/extracted_p24_install_probe/DiffPepBuilder-main")
+PROCESS_RECEPTOR = BASE_SRC / "experiments" / "process_receptor.py"
+INFERENCE_SCRIPT = BASE_SRC / "experiments" / "run_inference.py"
+DEFAULT_CONFIG = BASE_SRC / "config" / "base.yaml"
+DEFAULT_CHECKPOINT = Path("/mnt/sdb/kxc/stamp_models/weights/diffpepbuilder/diffpepbuilder_v1.pth")
+DEFAULT_PYTHON = Path("/mnt/sdb/kxc/stamp_models/envs/diffpepbuilder_py39/bin/python")
+
+
+def sha256_file(path: str | Path) -> str:
+    import hashlib
+
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(8192), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="DiffPepBuilder P33L real inference runner"
+    )
+    parser.add_argument("--target-pdb", required=True, help="Path to target receptor PDB")
+    parser.add_argument("--checkpoint", default=str(DEFAULT_CHECKPOINT), help="DiffPepBuilder checkpoint path")
+    parser.add_argument("--config", default=str(DEFAULT_CONFIG), help="DiffPepBuilder base config YAML")
+    parser.add_argument("--output-dir", required=True, help="Output directory")
+    parser.add_argument("--gate-file", required=True, help="Gate file path (must contain 'true')")
+    parser.add_argument("--num-candidates", type=int, default=3, help="Number of candidate peptides")
+    parser.add_argument("--seed", type=int, default=2024)
+    parser.add_argument("--min-length", type=int, default=8)
+    parser.add_argument("--max-length", type=int, default=30)
+    parser.add_argument("--samples-per-length", type=int, default=8)
+    parser.add_argument("--num-t", type=int, default=200)
+    parser.add_argument("--device", default="cuda", help="cpu or cuda")
+    parser.add_argument("--python", default=str(DEFAULT_PYTHON))
+    args = parser.parse_args(argv)
+    return args
+
+
+def _check_gate(gate_file: Path) -> None:
+    if not gate_file.is_file():
+        raise RuntimeError(f"Gate file missing: {gate_file}")
+    content = gate_file.read_text(encoding="utf-8").strip().lower()
+    if content not in {"1", "true", "yes", "on"}:
+        raise RuntimeError(f"Gate is closed: {gate_file} = {content!r}")
+
+
+def _preprocess_receptor(
+    python: Path, target_pdb: Path, work_dir: Path
+) -> dict:
+    """Run official process_receptor.py and return metadata row."""
+    processed_dir = work_dir / "processed"
+    processed_dir.mkdir(parents=True, exist_ok=True)
+    cmd = [
+        str(python),
+        str(PROCESS_RECEPTOR),
+        "--pdb_dir",
+        str(target_pdb.parent),
+        "--write_dir",
+        str(processed_dir),
+    ]
+    env = {**os.environ, "BASE_PATH": str(BASE_SRC)}
+    result = subprocess.run(cmd, capture_output=True, text=True, env=env, check=False)
+    if result.returncode != 0:
+        raise RuntimeError(f"process_receptor failed: {result.stderr}")
+
+    # Locate the generated .pkl and metadata.
+    pkl_files = list(processed_dir.glob("*.pkl"))
+    if not pkl_files:
+        raise RuntimeError("No processed .pkl file generated")
+    processed_pkl = pkl_files[0]
+    pdb_name = processed_pkl.stem
+    return {
+        "pdb_name": pdb_name,
+        "processed_file_path": str(processed_pkl.resolve()),
+        "modeled_seq_len": 100,  # updated after loading if needed
+        "oligomeric_detail": "monomeric",
+    }
+
+
+def _write_csv(csv_path: Path, row: dict) -> None:
+    fieldnames = ["pdb_name", "processed_file_path", "modeled_seq_len", "oligomeric_detail"]
+    with open(csv_path, "w", newline="", encoding="utf-8") as fh:
+        writer = csv.DictWriter(fh, fieldnames=fieldnames)
+        writer.writeheader()
+        writer.writerow({k: row.get(k, "") for k in fieldnames})
+
+
+def _write_inference_config(
+    config_path: Path,
+    base_config: Path,
+    csv_path: Path,
+    checkpoint: Path,
+    output_dir: Path,
+    args: argparse.Namespace,
+) -> None:
+    """Write a minimal Hydra config overriding the base inference config."""
+    import yaml
+
+    with open(base_config, "r", encoding="utf-8") as fh:
+        cfg = yaml.safe_load(fh)
+
+    cfg.setdefault("data", {})
+    cfg["data"]["val_csv_path"] = str(csv_path.resolve())
+    cfg.setdefault("experiment", {})
+    cfg["experiment"]["eval_ckpt_path"] = str(checkpoint.resolve())
+    cfg["experiment"]["eval_dir"] = str(output_dir.resolve())
+    cfg["experiment"]["use_gpu"] = args.device.startswith("cuda")
+    cfg["experiment"]["num_gpus"] = 1
+    cfg["experiment"]["use_ddp"] = False
+    cfg["experiment"]["eval_batch_size"] = 1
+    cfg["experiment"]["num_loader_workers"] = 2
+    cfg["experiment"]["use_wandb"] = False
+    cfg.setdefault("inference", {})
+    cfg["inference"]["seed"] = args.seed
+    cfg["inference"].setdefault("sampling", {})
+    cfg["inference"]["sampling"]["min_length"] = args.min_length
+    cfg["inference"]["sampling"]["max_length"] = args.max_length
+    cfg["inference"]["sampling"]["samples_per_length"] = args.samples_per_length
+    cfg["inference"].setdefault("denoising", {})
+    cfg["inference"]["denoising"]["num_t"] = args.num_t
+
+    config_path.parent.mkdir(parents=True, exist_ok=True)
+    with open(config_path, "w", encoding="utf-8") as fh:
+        yaml.safe_dump(cfg, fh, default_flow_style=False)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parse_args(argv)
+    start_time = time.time()
+    output_dir = Path(args.output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    manifest = {
+        "model_id": "diffpepbuilder",
+        "runner": "stamp_diffpepbuilder_p33l_real_runner.py",
+        "validation_status": "NOT_EXPERIMENTALLY_VALIDATED",
+        "computational_prediction_only": True,
+        "experimental_validation": False,
+        "target_pdb": str(Path(args.target_pdb).resolve()),
+        "checkpoint": str(Path(args.checkpoint).resolve()),
+        "checkpoint_sha256": sha256_file(args.checkpoint),
+        "config": str(Path(args.config).resolve()),
+        "gate_file": str(Path(args.gate_file).resolve()),
+        "output_dir": str(output_dir.resolve()),
+        "source_entry": str(INFERENCE_SCRIPT.resolve()),
+        "source_entry_sha256": sha256_file(INFERENCE_SCRIPT),
+        "command": " ".join(sys.argv),
+        "status": "BLOCKED",
+        "exit_code": 1,
+        "messages": [],
+    }
+
+    try:
+        _check_gate(Path(args.gate_file))
+        python = Path(args.python)
+        if not python.is_file():
+            raise RuntimeError(f"Python interpreter not found: {python}")
+
+        target_pdb = Path(args.target_pdb)
+        if not target_pdb.is_file():
+            raise RuntimeError(f"Target PDB not found: {target_pdb}")
+
+        checkpoint = Path(args.checkpoint)
+        if not checkpoint.is_file():
+            raise RuntimeError(f"Checkpoint not found: {checkpoint}")
+
+        work_dir = output_dir / "_work"
+        work_dir.mkdir(parents=True, exist_ok=True)
+
+        # 1. Preprocess receptor with official script.
+        metadata = _preprocess_receptor(python, target_pdb, work_dir)
+        manifest["preprocessed_receptor"] = metadata
+
+        # 2. Build CSV.
+        csv_path = work_dir / "receptors.csv"
+        _write_csv(csv_path, metadata)
+
+        # 3. Build inference config.
+        config_path = work_dir / "inference.yaml"
+        _write_inference_config(
+            config_path,
+            Path(args.config),
+            csv_path,
+            checkpoint,
+            output_dir,
+            args,
+        )
+
+        # 4. Invoke official DiffPepBuilder inference.
+        env = {**os.environ, "BASE_PATH": str(BASE_SRC), "CUDA_VISIBLE_DEVICES": "0" if args.device.startswith("cuda") else ""}
+        cmd = [
+            str(python),
+            str(INFERENCE_SCRIPT),
+            "--config-path",
+            str(config_path.parent),
+            "--config-name",
+            config_path.stem,
+        ]
+        manifest["inference_command"] = " ".join(cmd)
+        result = subprocess.run(cmd, cwd=str(BASE_SRC), env=env, check=False)
+        manifest["status"] = "SUCCESS" if result.returncode == 0 else "FAILED"
+        manifest["exit_code"] = result.returncode
+        manifest["messages"].append("Invoked official DiffPepBuilder inference entry.")
+
+    except Exception as exc:
+        manifest["status"] = "FAILED"
+        manifest["error"] = f"{exc.__class__.__name__}: {exc}"
+        manifest["messages"].append(str(manifest["error"]))
+
+    manifest["elapsed_seconds"] = round(time.time() - start_time, 4)
+    manifest_path = output_dir / "manifest.json"
+    with open(manifest_path, "w", encoding="utf-8") as fh:
+        json.dump(manifest, fh, indent=2, ensure_ascii=False)
+    print(json.dumps(manifest, indent=2, ensure_ascii=False))
+    return manifest["exit_code"]
+
+
+if __name__ == "__main__":
+    sys.exit(main())
