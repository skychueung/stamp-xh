# Auto-detect text files and normalize line endings to LF on checkout.
* text=auto

# Source code: always LF
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files: never treat as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pdb binary
*.npz binary
*.bin binary
*.pt binary
*.pth binary
*.safetensors binary
