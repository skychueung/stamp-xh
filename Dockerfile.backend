# STAMP Backend Dockerfile — OPTIONAL / DEMO-READY MINIMAL
# Local PowerShell startup is preferred for workshops.
# This Dockerfile is provided for optional containerization only.

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Initialize DB on first run
RUN python -c "from app.database import init_db; init_db()"

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
